  // JavaScript type-checking configuration for Link-Up.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "lib": ["ESNext", "DOM"]
  },
  "include": [
    "*.js",
    "features/**/*.js",
    "web/**/*.js",
    "scripts/**/*.js"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
